#!/usr/bin/env bash
# Fake timeout: the rubric runs `timeout N cmd` inside the sandbox, which the
# fake docker runs on the host. Stock macOS has no timeout, so drop N and run.
# FAKE_AGENT_TIMEOUT=1 makes every agent call (timeout N claude ...) run
# out of time.
if [ -n "${FAKE_AGENT_TIMEOUT:-}" ] && [ "${2:-}" = claude ]; then cat > /dev/null; exit 124; fi
shift
exec "$@"

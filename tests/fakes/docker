#!/usr/bin/env bash
# Fake docker for tests: "containers" are directories under $FAKE_STATE and
# container paths (/src.git, /work, /chalk) are rewritten into them.
set -euo pipefail
cmd="$1"; shift

rewrite() {
  printf '%s' "$1" | sed -E "s#(^|[ \"'=])/(src\.git|work|chalk)#\1$root/\2#g"
}

# With FAKE_DB_MODEL=1 the database containers (chalk-db*) and volumes are
# modelled: each container is a directory under $FAKE_STATE/dbs holding its
# image, volume and running state, and each volume one under
# $FAKE_STATE/volumes. Without it, every container exists and is running.
dbs="$FAKE_STATE/dbs"
volumes="$FAKE_STATE/volumes"
modelled() {
  [ -n "${FAKE_DB_MODEL:-}" ] || return 1
  case "$1" in chalk-db|chalk-db-*) return 0 ;; esac
  return 1
}
no_such() { echo "Error response from daemon: No such container: $1" >&2; exit 1; }

case "$cmd" in
  info) exit 0 ;;
  # FAKE_BUILD_FAIL=tls or =rate makes the build fail as it does behind a
  # proxy that re-signs HTTPS, or when the registry limits pulls.
  build)
    printf 'build %s\n' "$*" >> "$FAKE_STATE/docker.log"
    case "${FAKE_BUILD_FAIL:-}" in
      tls)  echo "npm error code SELF_SIGNED_CERT_IN_CHAIN"; exit 1 ;;
      rate) echo "failed to resolve source metadata: 429 Too Many Requests"; exit 1 ;;
    esac ;;
  start|stop)
    name="${*: -1}"
    modelled "$name" || exit 0
    [ -d "$dbs/$name" ] || no_such "$name"
    if [ "$cmd" = start ]; then echo true > "$dbs/$name/running"; else echo false > "$dbs/$name/running"; fi ;;
  ps) exit 0 ;;
  image) exit 0 ;;
  inspect)
    format=""
    if [ "$1" = "-f" ]; then format="$2"; shift 2; fi
    name="$1"
    if ! modelled "$name"; then echo true; exit 0; fi
    [ -d "$dbs/$name" ] || no_such "$name"
    case "$format" in
      *Running*) cat "$dbs/$name/running" ;;
      *Image*)   cat "$dbs/$name/image" ;;
      *Mounts*)  cat "$dbs/$name/volume" ;;
      *)         echo "[{\"Name\": \"/$name\"}]" ;;
    esac ;;
  rename)
    printf 'rename %s\n' "$*" >> "$FAKE_STATE/docker.log"
    if ! modelled "$1" && [ -d "$FAKE_STATE/$1" ]; then mv "$FAKE_STATE/$1" "$FAKE_STATE/$2"; exit 0; fi
    [ -d "$dbs/$1" ] || no_such "$1"
    [ ! -e "$dbs/$2" ] || { echo "Error response from daemon: name \"$2\" is already in use" >&2; exit 1; }
    mv "$dbs/$1" "$dbs/$2" ;;
  volume)
    sub="$1" name="$2"
    case "$sub" in
      inspect) [ -d "$volumes/$name" ] || { echo "Error: no such volume: $name" >&2; exit 1; } ;;
      rm) printf 'volume rm %s\n' "$name" >> "$FAKE_STATE/docker.log"
          rmdir "$volumes/$name" ;;
      *) echo "fake docker: unsupported volume command $sub" >&2; exit 1 ;;
    esac ;;
  rm)
    name="${*: -1}"
    if modelled "$name"; then
      printf 'rm %s\n' "$name" >> "$FAKE_STATE/docker.log"
      [ -d "$dbs/$name" ] || no_such "$name"
      rm -rf "${dbs:?}/$name"
    else
      rm -rf "${FAKE_STATE:?}/$name"
    fi ;;
  run)
    printf '%s\n' "$*" >> "$FAKE_STATE/docker.log"
    # A one-off command (--entrypoint) runs on the host with the arguments
    # after the image, and with stdin passed through.
    # chalk doctor's TLS probe: FAKE_TLS is what it prints, "ok" by default,
    # so that no test reaches the network.
    if [[ " $* " == *" node -e "* ]]; then
      echo "${FAKE_TLS:-ok}"
      exit 0
    fi
    if [[ " $* " == *" --entrypoint "* ]]; then
      entrypoint=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --entrypoint) entrypoint="$2"; shift ;;
          --user|-e|-v|--name) shift ;;
          -*) ;;
          *) shift; break ;;
        esac
        shift
      done
      exec "$entrypoint" "$@"
    fi
    name="" mounts=() image=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name="$2"; shift ;;
        -v) mounts+=("$2"); shift ;;
        -e|-p|--restart|--label|--user|--tmpfs|--security-opt|--cap-drop|--memory|--cpus|--network) shift ;;
        -*) ;;
        # The first argument that is not an option is the image; the rest
        # are the command.
        *) [ -n "$image" ] || image="$1" ;;
      esac
      shift
    done
    if modelled "$name"; then
      # mkdir is atomic, like docker's own check on container names.
      mkdir -p "$dbs" "$volumes"
      if ! mkdir "$dbs/$name" 2>/dev/null; then
        echo "docker: Error response from daemon: Conflict. The container name \"/$name\" is already in use." >&2
        exit 125
      fi
      volume="${mounts[0]%%:*}"
      mkdir -p "$volumes/$volume"
      echo "$image" > "$dbs/$name/image"
      echo "$volume" > "$dbs/$name/volume"
      echo true > "$dbs/$name/running"
      echo "fake-$name"
      exit 0
    fi
    root="$FAKE_STATE/$name"
    mkdir -p "$root/work" "$root/home"
    # Commands run in the container see its image as FAKE_CONTAINER_IMAGE,
    # so that a test can tell images apart.
    printf '%s\n' "$image" > "$root/image"
    for mount in "${mounts[@]}"; do
      host="${mount%%:*}"; rest="${mount#*:}"
      ln -sfn "$host" "$root${rest%%:*}"
    done
    echo "fake-$name" ;;
  exec)
    workdir=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -i|-it) ;;
        -w) workdir="$2"; shift ;;
        *) break ;;
      esac
      shift
    done
    name="$1"; shift
    if [ "$name" = "chalk-db" ]; then
      if modelled "$name" && [ "$(cat "$dbs/$name/running" 2>/dev/null)" != true ]; then
        echo "Error response from daemon: container $name is not running" >&2
        exit 1
      fi
      if [ "$1" = "pg_dumpall" ]; then
        printf -- '--\n-- PostgreSQL database cluster dump\n--\n'
        exit 0
      fi
      [ "$1" = "psql" ] || exit 0
      # FAKE_DB_BROKEN=1 makes every query fail.
      [ -z "${FAKE_DB_BROKEN:-}" ] || exit 1
      sql="$(cat)"
      # FAKE_DB_FAIL_ON=TEXT makes every query containing TEXT fail, as
      # when the database goes away in the middle of a run.
      if [ -n "${FAKE_DB_FAIL_ON:-}" ] && [[ $sql == *"$FAKE_DB_FAIL_ON"* ]]; then
        echo "psql: error: server closed the connection unexpectedly" >&2
        exit 2
      fi
      printf '%s\n---\n%s\n' "$*" "$sql" >> "$FAKE_STATE/db.log"
      # FAKE_DB_RESTORE_FAIL=1 makes restoring a dump fail.
      case "$sql" in
        *"database cluster dump"*) [ -z "${FAKE_DB_RESTORE_FAIL:-}" ] || exit 3 ;;
      esac
      # With FAKE_PG_URL set, the SQL runs against a real Postgres instead of
      # returning canned answers.
      if [ -n "${FAKE_PG_URL:-}" ]; then
        shift
        args=()
        while [ $# -gt 0 ]; do
          case "$1" in -U|-d) shift ;; *) args+=("$1") ;; esac
          shift
        done
        printf '%s\n' "$sql" | psql "$FAKE_PG_URL" "${args[@]}"
        exit
      fi
      case "$sql" in
        # A ticket's summary. Its state is worked out from the calls and
        # events logged so far, as db_ticket_summary's query does.
        *"FROM runs r WHERE"*)
          ticket="$(printf '%s\n' "$*" | sed -n 's/.* -v ticket=\([^ ]*\).*/\1/p')"
          repo="$(printf '%s\n' "$*" | sed -n 's/.* -v repo=\([^ ]*\).*/\1/p')"
          state="$(awk -v t="$ticket" -v r="$repo" '
            /^psql -X/ { args = $0; sql = 0; next }
            !sql && $0 == "---" { sql = 1; first = 1; next }
            !sql { args = args " " $0; next }
            !first { next }
            {
              first = 0
              if (index(args " ", " -v ticket=" t " ") == 0 || index(args " ", " -v repo=" r " ") == 0) next
              kind = ""; status = ""
              if (match(args, / -v kind=[^ ]*/)) kind = substr(args, RSTART + 9, RLENGTH - 9)
              if (match(args, / -v status=[^ ]*/)) status = substr(args, RSTART + 11, RLENGTH - 11)
              if ($0 ~ /INSERT INTO events/) event = kind
              else if ($0 ~ /INSERT INTO runs/ && kind != "distill") {
                event = ""
                last = (kind == "review" && status == "pass") ? "ready" : "stopped"
              }
            }
            END { print (event != "" ? event : last != "" ? last : "new") }' "$FAKE_STATE/db.log")"
          echo "2 0.5000 0 $state" ;;
        *"chalk db upgrade: row counts"*) echo "3 1 2" ;;
        # The report card's data, and the counts chalk share adds to it.
        # FAKE_DASHBOARD and FAKE_SHARE_COUNTS name files to answer with instead.
        *"'generated_at'"*)
          if [ -n "${FAKE_DASHBOARD:-}" ]; then cat "$FAKE_DASHBOARD"; exit 0; fi
          echo '{"generated_at":"2026-01-01 00:00","days":30,"submitted":0,"detentions":0,"totals":{"calls":0},"note":"</script>"}' ;;
        *"chalk share:"*)
          if [ -n "${FAKE_SHARE_COUNTS:-}" ]; then cat "$FAKE_SHARE_COUNTS"; else echo '{}'; fi ;;
        *"SELECT signature FROM lessons"*) echo "rubric failed (exit 1)" ;;
        # FAKE_CERTIFY=JSON: what db_certify_verdicts answers (certify.sh);
        # unset, nothing, as when there is no evidence to read.
        *"-- chalk certify: verdicts"*) printf '%s\n' "${FAKE_CERTIFY:-}" ;;
        # The evidence record's ledger: FAKE_ATTEST_LEDGER, or two calls.
        *"-- chalk attest: ledger"*)
          ledger='{"loops":[{"loop":1,"kind":"continue","rubric_exit":0,"cost_usd":0.25},{"loop":0,"kind":"review","rubric_exit":0,"cost_usd":0.25}],"lessons":[],"cost_usd":0.5}'
          printf '%s\n' "${FAKE_ATTEST_LEDGER:-$ledger}" ;;
        # chalk tune's runs (FAKE_TUNE_DATA, none by default) and what
        # exploring has spent (FAKE_EXPLORE_SPENT, 0 by default).
        *"-- chalk tune: runs"*) printf '%s\n' "${FAKE_TUNE_DATA:-[]}" ;;
        *"-- chalk tune: explore spent"*) printf '%s\n' "${FAKE_EXPLORE_SPENT:-0}" ;;
        # FAKE_PENDING_EVIDENCE=JSON: what db_pending_evidence answers; {}
        # by default, as for a lesson with no probe.
        *"'before_outcome', before_outcome"*) printf '%s\n' "${FAKE_PENDING_EVIDENCE:-{\}}" ;;
        # FAKE_OPEN_MATCH=TICKET: an open lesson of TICKET has the same fingerprint.
        *"SELECT ticket FROM lessons"*) echo "${FAKE_OPEN_MATCH:-}" ;;
        # db_decider_gate: no resolved lessons, and no embedding column.
        *"FILTER (WHERE resolution IS NOT NULL)"*) echo "0 0" ;;
      esac
      exit 0
    fi
    # FAKE_SANDBOX_BASH="5 1" makes the sandbox report an older bash.
    if [ -n "${FAKE_SANDBOX_BASH:-}" ] && [[ "$*" == *BASH_VERSINFO* ]]; then
      echo "$FAKE_SANDBOX_BASH"
      exit 0
    fi
    root="$FAKE_STATE/$name"
    FAKE_CONTAINER_IMAGE="$(cat "$root/image" 2>/dev/null || true)"
    export FAKE_CONTAINER_IMAGE
    args=()
    for arg in "$@"; do args+=("$(rewrite "$arg")"); done
    if [ -n "$workdir" ]; then cd "$(rewrite "$workdir")"; fi
    HOME="$root/home" exec "${args[@]}" ;;
  *) echo "fake docker: unsupported command $cmd" >&2; exit 1 ;;
esac

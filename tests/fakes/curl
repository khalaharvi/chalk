#!/usr/bin/env bash
# Fake curl standing in for a Hindsight server.
url="${*: -1}"
body=""
case " $* " in *" @- "*) body="$(cat)" ;; esac
printf '%s\n%s\n' "$url" "$body" >> "$FAKE_STATE/curl.log"
case "$url" in
  */memories/recall) echo '{"results":[{"text":"Use the sandbox base URL in tests"}]}' ;;
  */memories)        echo '{"success":true}' ;;
  *)                 echo '{}' ;;
esac

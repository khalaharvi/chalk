# Chalk configuration for this repository.
# Plain KEY=value lines. No quotes, no shell expansion. Environment variables
# of the same name override these.

# Branch that workstreams start from and merge back into.
CHALK_BASE_BRANCH=main
# Where the repository is hosted: github, gitlab, or auto (GitHub when the
# origin remote is on github.com, otherwise GitLab). Set github for
# GitHub Enterprise.
CHALK_FORGE=auto

# The rubric. Must exit 0 only when the work is acceptable. Runs with
# bash -c in the sandbox after every agent loop, and again in CI.
CHALK_TEST_CMD=
# Runs once in a fresh sandbox (and in CI) before the rubric, e.g. npm ci.
# The sandbox runs as you, not root: it can install into the repository or
# $HOME (npm ci, go mod download, a Python venv), never system packages.
CHALK_SETUP_CMD=
# Seconds before a hung rubric is killed.
CHALK_RUBRIC_TIMEOUT=900
# Optional test report the rubric writes, as a path inside the repo: JUnit
# XML, go test -json output or a jest --json report, told apart by content.
# Names the failing tests more reliably than the rubric's output. The
# rubric must still print its failures: a retry is told the last lines of
# its output. For example, CHALK_TEST_CMD, then CHALK_TEST_REPORT:
#   pytest --junitxml=report.xml                                    report.xml
#   go test -json ./... > report.json || { go test ./...; exit 1; }  report.json
#   npx jest --json --outputFile=report.json                        report.json
# go test -json prints only JSON, so that rubric keeps it in the report and,
# when the tests fail, runs them again for output a person can read.
CHALK_TEST_REPORT=

# Spend cap per agent loop, in USD, enforced by Claude Code.
CHALK_BUDGET_USD=1.00
# Loops per run before detention. Worst-case spend per run is
# CHALK_BUDGET_USD x CHALK_MAX_LOOPS.
CHALK_MAX_LOOPS=20
# Consecutive failed loops tolerated before detention.
CHALK_MAX_RETRIES=2
# Each loop that makes no progress gets a verdict from its failing tests,
# first error and working tree (see `chalk dashboard`):
#   shadow  record the verdicts only
#   on      also detain at once when a loop repeats itself, changes nothing,
#           or fails like an open detention on another ticket
#   off     compute nothing
CHALK_FP_RULES=shadow
# What a retry is told about the failed loop before it:
#   false  the reason and the last 60 lines of the rubric's output
#   true   the failing tests and first error, normalized, and the last 20
#          lines (needs CHALK_FP_RULES shadow or on). The dashboard's prompt
#          sets compare the two.
CHALK_FP_FEEDBACK=false
# Agents `chalk fleet` will run at once on one machine. auto picks the
# smallest of 8, half of Docker's CPUs, and Docker's memory less 1 GiB
# divided by CHALK_SANDBOX_MEM_MB (4 when Docker cannot be asked).
CHALK_MAX_PARALLEL=auto
# Memory one sandbox needs, in MiB, for CHALK_MAX_PARALLEL=auto.
CHALK_SANDBOX_MEM_MB=2048

# Sandbox image. Needs bash 5.2 or newer, git, coreutils and the claude CLI.
# The default is Node 22. For another stack, build an image FROM
# chalk-sandbox:local (chalk sandbox build) with your toolchain, and set
# CHALK_CI_IMAGE in CI as well: see "Use your own stack" in the docs.
CHALK_IMAGE=chalk-sandbox:local
# RAM disk size for the working copy and its dependencies.
CHALK_TMPFS_SIZE=4g

# Global engineering rules appended to the agent's system prompt.
CHALK_TEXTBOOK=.chalk/textbook.md
# Push and open the pull or merge request automatically when a run completes.
CHALK_AUTO_MR=true
# Before the first loop, a cheap model checks that every checkpoint is small,
# testable and unambiguous, and stops the run if not.
CHALK_SPEC_CHECK=true
# When all checkpoints are done, an independent agent reviews the change for
# stubs, weakened tests and drift from the spec before the merge request.
CHALK_REVIEW=true
# Fix-and-review-again rounds allowed before the work goes to detention.
CHALK_REVIEW_ROUNDS=1
# Model for the review (empty: same as the loop).
CHALK_REVIEW_MODEL=
# Model for the spec check and lesson distillation.
CHALK_CHEAP_MODEL=haiku
# At office hours, turn the engineer's note and fix into a general lesson.
CHALK_DISTILL=true

# How loops are permitted to act inside the sandbox:
#   auto    Claude Code's auto mode: a safety classifier reviews actions.
#   bypass  --dangerously-skip-permissions. Only where your organisation allows it.
# The spec check, review and distillation are always read-only.
CHALK_PERMISSION_MODE=auto

# Optional model override, passed to `claude --model`. Auto mode needs a
# model that supports it (not Haiku).
CHALK_MODEL=
